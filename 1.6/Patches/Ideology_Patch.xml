<?xml version='1.0' encoding='utf-8'?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Ideology</li>
        </mods>
		<match Class="PatchOperationSequence"><operations><li Class="PatchOperationReplace">
					<xpath>/Defs/WorkGiverDef[defName = "EnslavePrisoner"]/workType</xpath>
					<value>
						<workType>Recruiting</workType>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/WorkGiverDef[defName = "ConvertPrisoner"]/workType</xpath>
					<value>
						<workType>Recruiting</workType>
					</value>
				</li>
			</operations></match></Operation>        
</Patch>