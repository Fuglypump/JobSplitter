<?xml version="1.0" encoding="utf-8"?>

<Patch>
  <!-- Dubs Bad Hygiene -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Dubs Bad Hygiene</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
			<xpath>*/WorkGiverDef[defName = "DoBillsBurnPit"]/workType</xpath>
			<value><workType>Mortifying</workType></value>
		</li>
      </operations>
    </match>
  </Operation>
</Patch>
