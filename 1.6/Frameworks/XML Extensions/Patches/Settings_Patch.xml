<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	
	<!-- Surgeon -->	
	<Operation Class="XmlExtensions.UseSetting" MayRequire="Ludeon.RimWorld.Biotech">
		<modId>Fuglypump.JobSplitter</modId>
		<key>enableSurgeon</key>
		<defaultValue>true</defaultValue>
		<apply>
			<li Class="PatchOperationAdd">
				<xpath>/Defs/WorkTypeDef[defName="Surgeon"]</xpath>
				<value>
					<visible>{enableSurgeon}</visible>
				</value>
			</li>
		</apply>
	</Operation>
	
