	<!-- Teaching / Childcare -->
	<Operation Class="XmlExtensions.OptionalPatch" MayRequire="Ludeon.RimWorld.Biotech">
		<modId>Fuglypump.JobSplitter</modId>
		<key>enableNursingBabies</key>
		<defaultValue>true</defaultValue>
		<caseTrue>
			<li Class="XmlExtensions.OptionalPatch">
				<modId>Fuglypump.JobSplitter</modId>
				<key>enableTeaching</key>
				<defaultValue>true</defaultValue>
				<!-- Babies ON + Teaching ON = Childcare becomes Teaching -->
				<caseTrue>
					<li Class="PatchOperationAdd">
						<xpath>/Defs/WorkTypeDef[defName="Teaching"]</xpath>
						<value>
							<visible>false</visible>
						</value>
					</li>
				</caseTrue>
				<!-- Babies ON + Teaching OFF = Hide Teaching -->
				<caseFalse>
					<li Class="PatchOperationAdd">
						<xpath>/Defs/WorkTypeDef[defName="Teaching"]</xpath>
						<value>
							<visible>false</visible>
						</value>
					</li>
				</caseFalse>
			</li>
		</caseTrue>
		<caseFalse>	
			<li Class="XmlExtensions.OptionalPatch">
				<modId>Fuglypump.JobSplitter</modId>
				<key>enableTeaching</key>
				<defaultValue>true</defaultValue>
				<!-- Babies OFF + Teaching ON = separate Teaching WorkType -->
				<caseTrue>
					<li Class="PatchOperationAdd">
						<xpath>/Defs/WorkTypeDef[defName="Teaching"]</xpath>
						<value>
							<visible>true</visible>
						</value>
					</li>
				</caseTrue>
				<!-- Babies OFF + Teaching OFF = normal Childcare -->
				<caseFalse>
					<li Class="PatchOperationAdd">
						<xpath>/Defs/WorkTypeDef[defName="Teaching"]</xpath>
						<value>
							<visible>false</visible>
						</value>
					</li>
				</caseFalse>
			</li>
		</caseFalse>
	</Operation>
	
