<?xml version="1.0" encoding="utf-8"?>

<Patch>
  <!-- Fruit Blend -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Fruit Blend</li>
	  <li>Fruit Blend (Continued)</li>
    </mods>
	<match Class="XmlExtensions.OptionalPatch">
			<modId>Fuglypump.JobSplitter</modId>
			<key>enableButchering</key>
			<defaultValue>true</defaultValue>
			<caseTrue>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/RecipeDef[defName = "FruitBlendFive"]/requiredGiverWorkType</xpath>
					<value>
						<requiredGiverWorkType>Butchering</requiredGiverWorkType>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/RecipeDef[defName = "FruitBlendTwenty"]/requiredGiverWorkType</xpath>
					<value>
						<requiredGiverWorkType>Butchering</requiredGiverWorkType>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/RecipeDef[defName = "FruitBlendFifty"]/requiredGiverWorkType</xpath>
					<value>
						<requiredGiverWorkType>Butchering</requiredGiverWorkType>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/RecipeDef[defName = "FruitBlendSevenFive"]/requiredGiverWorkType</xpath>
					<value>
						<requiredGiverWorkType>Butchering</requiredGiverWorkType>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/RecipeDef[defName = "FruitBlendHundo"]/requiredGiverWorkType</xpath>
					<value>
						<requiredGiverWorkType>Butchering</requiredGiverWorkType>
					</value>
				</li>
			</caseTrue>
			<caseFalse>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/RecipeDef[defName = "FruitBlendFive"]/requiredGiverWorkType</xpath>
					<value>
						<requiredGiverWorkType>Cooking</requiredGiverWorkType>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/RecipeDef[defName = "FruitBlendTwenty"]/requiredGiverWorkType</xpath>
					<value>
						<requiredGiverWorkType>Cooking</requiredGiverWorkType>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/RecipeDef[defName = "FruitBlendFifty"]/requiredGiverWorkType</xpath>
					<value>
						<requiredGiverWorkType>Cooking</requiredGiverWorkType>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/RecipeDef[defName = "FruitBlendSevenFive"]/requiredGiverWorkType</xpath>
					<value>
						<requiredGiverWorkType>Cooking</requiredGiverWorkType>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/RecipeDef[defName = "FruitBlendHundo"]/requiredGiverWorkType</xpath>
					<value>
						<requiredGiverWorkType>Cooking</requiredGiverWorkType>
					</value>
				</li>
			</caseFalse>
		</match>
  </Operation>
</Patch>
