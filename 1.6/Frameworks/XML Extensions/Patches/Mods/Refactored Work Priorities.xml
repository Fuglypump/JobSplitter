<?xml version="1.0" encoding="utf-8"?>

<Patch>
  <!-- Refactored Work Priorities -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Refactored Work Priorities</li>
	  <li>Refactored Work Priorities (Continued)</li>
    </mods>
	<match Class="XmlExtensions.OptionalPatch">
		<modId>Fuglypump.JobSplitter</modId>
		<key>enableHarvesting</key>
		<defaultValue>true</defaultValue>
		<caseTrue>
			<li Class="PatchOperationReplace">
				<xpath>*/WorkGiverDef[defName = "HarvestYieldingPlants"]/workType</xpath>
				<value>
					<workType>Harvesting</workType>
				</value>
			</li>
		</caseTrue>
		<caseFalse>
			<li Class="PatchOperationReplace">
				<xpath>*/WorkGiverDef[defName = "HarvestYieldingPlants"]/workType</xpath>
				<value>
					<workType>Growing</workType>
				</value>
			</li>
		</caseFalse>
	</match>
  </Operation>
</Patch>
