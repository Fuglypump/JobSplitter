<?xml version="1.0" encoding="utf-8"?>

<Patch>
  <!-- Smokeleaf Industry -->
  <Operation Class="PatchOperationFindMod">
    <mods>
	  <li>Smokeleaf Industry</li>
      <li>Smokeleaf Industry Reborn</li>
	  <li>Smokeleaf Industry (Continued)</li>
    </mods>
	<match Class="XmlExtensions.OptionalPatch">
		<modId>Fuglypump.JobSplitter</modId>
		<key>enableDrugs</key>
		<defaultValue>true</defaultValue>
		<caseTrue>
			<li Class="PatchOperationReplace">
			  <xpath>*/WorkGiverDef[defName = "DoBillsCultivationBench"]/workType</xpath>
			  <value>
				<workType>Drugs</workType>
			  </value>
			</li>
			<li Class="PatchOperationReplace">
			  <xpath>*/WorkGiverDef[defName = "DoBillsAutoTrimmer"]/workType</xpath>
			  <value>
				<workType>Drugs</workType>
			  </value>
			</li>
			<li Class="PatchOperationReplace">
			  <xpath>*/WorkGiverDef[defName = "DoBillsProduceMedicinals"]/workType</xpath>
			  <value>
				<workType>Drugs</workType>
			  </value>
			</li>
		</caseTrue>
		<caseFalse>
			<li Class="PatchOperationReplace">
			  <xpath>*/WorkGiverDef[defName = "DoBillsCultivationBench"]/workType</xpath>
			  <value>
				<workType>Crafting</workType>
			  </value>
			</li>
			<li Class="PatchOperationReplace">
			  <xpath>*/WorkGiverDef[defName = "DoBillsAutoTrimmer"]/workType</xpath>
			  <value>
				<workType>Crafting</workType>
			  </value>
			</li>
			<li Class="PatchOperationReplace">
			  <xpath>*/WorkGiverDef[defName = "DoBillsProduceMedicinals"]/workType</xpath>
			  <value>
				<workType>Crafting</workType>
			  </value>
			</li>
		</caseFalse>
	</match>
  </Operation>
</Patch>
