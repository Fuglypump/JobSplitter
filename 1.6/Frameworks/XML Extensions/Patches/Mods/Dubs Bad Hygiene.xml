<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Dubs Bad Hygiene</li>
		</mods>
		<match Class="XmlExtensions.OptionalPatch">
			<modId>Fuglypump.JobSplitter</modId>
			<key>enableMortifying</key>
			<defaultValue>true</defaultValue>
			<caseTrue>
				<li Class="PatchOperationReplace">
				<xpath>*/WorkGiverDef[defName = "DoBillsBurnPit"]/workType</xpath>
					<value><workType>Mortifying</workType></value>
				</li>
			</caseTrue>
			<caseFalse>
				<li Class="PatchOperationReplace">
				<xpath>*/WorkGiverDef[defName = "DoBillsBurnPit"]/workType</xpath>
					<value><workType>Hauling</workType></value>
				</li>
			</caseFalse>
		</match>
	</Operation>
</Patch>
