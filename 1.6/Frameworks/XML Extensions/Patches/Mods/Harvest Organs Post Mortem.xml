<?xml version="1.0" encoding="utf-8"?>

<Patch>
  <!-- Harvest Organs Post Mortem -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Harvest Organs Post Mortem</li>
	  <li>Harvest Organs Post Mortem Continued</li>
    </mods>
	<match Class="XmlExtensions.OptionalPatch">
		<modId>Fuglypump.JobSplitter</modId>
		<key>enableSurgeon</key>
		<defaultValue>true</defaultValue>
		<caseTrue>
			<li Class="PatchOperationReplace">
				<xpath>/Defs/WorkGiverDef[defName = "DoBillsMedicalHumanOperationOrgans"]/workType</xpath>
				<value>
					<workType>Surgeon</workType>
				</value>
			</li>
		</caseTrue>
		<caseFalse>
			<li Class="PatchOperationReplace">
				<xpath>/Defs/WorkGiverDef[defName = "DoBillsMedicalHumanOperationOrgans"]/workType</xpath>
				<value>
					<workType>Doctor</workType>
				</value>
			</li>
		</caseFalse>
	</match>
  </Operation>
</Patch>
