<?xml version="1.0" encoding="utf-8"?>

<Patch>
  <!-- Medieval Overhaul -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Medieval Overhaul</li>
    </mods>
	<match Class="XmlExtensions.OptionalPatch">
		<modId>Fuglypump.JobSplitter</modId>
		<key>enableRearming</key>
		<defaultValue>true</defaultValue>
		<caseTrue>
			<li Class="PatchOperationReplace">
				<xpath>/Defs/WorkGiverDef[defName = "DankPyon_RefuelCustom"]/workType</xpath>
				<value>
					<workType>Rearming</workType>
				</value>
			</li>
		</caseTrue>
		<caseFalse>
			<li Class="PatchOperationReplace">
				<xpath>/Defs/WorkGiverDef[defName = "DankPyon_RefuelCustom"]/workType</xpath>
				<value>
					<workType>Hauling</workType>
				</value>
			</li>
		</caseFalse>
	</match>
  </Operation>
</Patch>
