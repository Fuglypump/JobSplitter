<?xml version="1.0" encoding="utf-8"?>

<Patch>
  <!-- CuproPanda's Drinks -->
  <Operation Class="PatchOperationFindMod">
    <mods>
	  <li>Cupro's Drinks - Core</li>
	  <li>CuproPanda's Drinks</li>
    </mods>
	<match Class="XmlExtensions.OptionalPatch">
		<modId>Fuglypump.JobSplitter</modId>
		<key>enableBrewing</key>
		<defaultValue>false</defaultValue>
		<caseTrue>
			<li Class="PatchOperationReplace">
				<xpath>/Defs/WorkGiverDef[defName = "CPD_DoBillsDrinksTable"]/workType</xpath>
				<value>
					<workType>Brewing</workType>
				</value>
			</li>
		</caseTrue>
		<caseFalse>
			<li Class="PatchOperationReplace">
				<xpath>/Defs/WorkGiverDef[defName = "CPD_DoBillsDrinksTable"]/workType</xpath>
				<value>
					<workType>Cooking</workType>
				</value>
			</li>
		</caseFalse>
	</match>
  </Operation>
</Patch>
