<?xml version="1.0" encoding="utf-8"?>

<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods><li>Misc. Robots</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="XmlExtensions.OptionalPatch">
          <modId>Fuglypump.JobSplitter</modId>
          <key>enableLoading</key><defaultValue>false</defaultValue>
          <caseFalse><li Class="PatchOperationRemove"><xpath>*/ThingDef[defName = "AIRobot_Hauler"]/robotWorkTypes/li[workTypeDef = "Loading"]</xpath></li></caseFalse>
        </li>
        <li Class="XmlExtensions.OptionalPatch">
          <modId>Fuglypump.JobSplitter</modId>
          <key>enableDelivering</key><defaultValue>true</defaultValue>
          <caseFalse><li Class="PatchOperationRemove"><xpath>*/ThingDef[defName = "AIRobot_Hauler"]/robotWorkTypes/li[workTypeDef = "Delivering"]</xpath></li></caseFalse>
        </li>
        <li Class="XmlExtensions.OptionalPatch">
          <modId>Fuglypump.JobSplitter</modId>
          <key>enableRearming</key><defaultValue>true</defaultValue>
          <caseFalse>
            <li Class="PatchOperationRemove"><xpath>*/ThingDef[defName = "AIRobot_Hauler"]/robotWorkTypes/li[workTypeDef = "Rearming"]</xpath></li>
            <li Class="PatchOperationRemove"><xpath>*/ThingDef[defName = "AIRobot_Cleaner"]/robotWorkTypes/li[workTypeDef = "Rearming"]</xpath></li>
          </caseFalse>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
