<?xml version="1.0" encoding="utf-8"?>

<Patch>
	<!-- Save Our Ship 2 -->
	<Operation Class="PatchOperationFindMod">
		<mods>
		  <li>Save Our Ship 2</li>
		</mods>
		<match Class="XmlExtensions.OptionalPatch">
			<modId>Fuglypump.JobSplitter</modId>
			<key>enableRearming</key>
			<defaultValue>true</defaultValue>
			<caseTrue>
				<li Class="PatchOperationReplace">
				<xpath>*/WorkGiverDef[defName = "LoadTorpedoTube"]/workType</xpath>
					<value>
						<workType>Rearming</workType>
					</value>
				</li>
			</caseTrue>
			<caseFalse>
				<li Class="PatchOperationReplace">
				<xpath>*/WorkGiverDef[defName = "LoadTorpedoTube"]/workType</xpath>
					<value>
						<workType>Hauling</workType>
					</value>
				</li>
			</caseFalse>
		</match>
	</Operation>
</Patch>
