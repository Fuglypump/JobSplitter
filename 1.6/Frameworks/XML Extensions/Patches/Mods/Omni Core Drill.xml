<?xml version="1.0" encoding="utf-8"?>

<Patch>
  <!-- Omni Core Drill -->
	<Operation Class="PatchOperationFindMod">
		<mods>
		  <li>Omni Core Drill</li>
		  <li>Omni Core Drill (Continued)</li>
		</mods>
		<match Class="XmlExtensions.OptionalPatch">
			<modId>Fuglypump.JobSplitter</modId>
			<key>enableDrilling</key>
			<defaultValue>true</defaultValue>
			<caseTrue>
				<li Class="PatchOperationReplace">
					<xpath>*/WorkGiverDef[defName = "DoBillsCoreMine"]/workType</xpath>
					<value>
						<workType>Drilling</workType>
					</value>
				</li>
			</caseTrue>
			<caseFalse>
				<li Class="PatchOperationReplace">
					<xpath>*/WorkGiverDef[defName = "DoBillsCoreMine"]/workType</xpath>
					<value>
						<workType>Mining</workType>
					</value>
				</li>
			</caseFalse>
		</match>
	</Operation>
</Patch>
