<?xml version="1.0" encoding="utf-8"?>

<Patch>
  <!-- VGP Garden Drinks UF -->
  <Operation Class="PatchOperationFindMod">
    <mods>
	  <li>VGP Garden Drinks</li>
      <li>VGP Garden Drinks UF</li>
    </mods>
	<match Class="XmlExtensions.OptionalPatch">
		<modId>Fuglypump.JobSplitter</modId>
		<key>enableBrewing</key>
		<defaultValue>false</defaultValue>
		<caseTrue>
			<li Class="PatchOperationReplace">
				<xpath>/Defs/WorkGiverDef[defName = "CPD_DoBillsDrinksTable"]/workType</xpath>
				<value>
					<workType>Brewing</workType>
				</value>
			</li>
			<li Class="PatchOperationReplace">
				<xpath>/Defs/WorkGiverDef[defName = "DoBillsBrew"]/workType</xpath>
				<value>
					<workType>Brewing</workType>
				</value>
			</li>
		</caseTrue>
		<caseFalse>
			<li Class="PatchOperationReplace">
				<xpath>/Defs/WorkGiverDef[defName = "CPD_DoBillsDrinksTable"]/workType</xpath>
				<value>
					<workType>Cooking</workType>
				</value>
			</li>
			<li Class="PatchOperationReplace">
				<xpath>/Defs/WorkGiverDef[defName = "DoBillsBrew"]/workType</xpath>
				<value>
					<workType>Cooking</workType>
				</value>
			</li>
		</caseFalse>
	</match>
  </Operation>
</Patch>
