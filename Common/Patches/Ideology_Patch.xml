<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Ideology</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <!-- Mortifying -->
                <li Class="PatchOperationReplace">
                    <xpath>*/WorkGiverDef[defName = "ExtractSkull"]/workType</xpath>
                    <value>
                        <workType>Mortifying</workType>
                    </value>
                </li>
                
                <!-- Recruiting -->
                <li Class="PatchOperationReplace">
                    <xpath>*/WorkGiverDef[defName = "EnslavePrisoner"]/workType</xpath>
                    <value>
                        <workType>Recruiting</workType>
                    </value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>*/WorkGiverDef[defName = "ConvertPrisoner"]/workType</xpath>
                    <value>
                        <workType>Recruiting</workType>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>        
</Patch>